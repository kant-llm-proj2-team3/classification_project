OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
MAX_INPUT_CHARS=4000
MAX_OUTPUT_TOKENS=512
GENERATION_TIMEOUT_SECONDS=120
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
# jev 평가(jev/scripts/step06_eval_jev.py)의 선택 항목. 비워 두면 기본값을 쓴다. (기본값은 jev/scripts/jev_settings.py)
JEV_BASE_URL=
JEV_CONCURRENCY=
# CLM 계열(jev/scripts/step05_train_clm.py). 모두 비워 두면 기본값을 쓴다. (기본값은 jev/scripts/clm_settings.py)
CLM_TOOLS_DIR=
CLM_REPO=
CLM_LLAMA_SERVER=
CLM_ENCODER_URL=
CLM_GPU_LAYERS=
CLM_UBATCH=
# 서비스 분류 모델(fastapi/classifier.py). 비워 두면 artifacts/<토픽>/advanced_merge/recommendation.json의 추천 모델을 쓴다.
# 직접 지정하려면 laya, clm, bert, roberta, koelectra 중 하나를 적는다. CLASSIFIER_DEVICE는 비우면 cuda(없으면 cpu).
CLASSIFIER_MODEL_DOCUMENTS=
CLASSIFIER_MODEL_INQUIRIES=
CLASSIFIER_DEVICE=
# 생성 모델(OpenAI)의 추론 강도. 추론 토큰도 MAX_OUTPUT_TOKENS에 포함되므로 낮춰 둔다. 기본 low, 추론을 지원하지 않는 모델이면 off.
OPENAI_REASONING_EFFORT=
